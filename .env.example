# Optional: leave empty to run without live Shodan collection.
# Get a key at https://account.shodan.io/
SHODAN_API_KEY=

# Optional: NVD API 2.0 key lifts the keyless rate limit (5 requests / 30s).
# Get one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Default scan mode for new scans: "live" (real collection) or "demo" (synthetic).
RECON_DEFAULT_MODE=live
